---
import { nav, site } from '../data/site';
const { pathname } = Astro.url;
---

<header class="relative z-20 border-b border-[var(--color-border)] bg-[var(--color-bg)]/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4 sm:px-6">
    <a href="/" class="group flex items-baseline gap-2 font-display font-black tracking-widest no-underline">
      <span class="glitch text-xl text-white" data-text={site.name}>{site.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => {
          const active = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'inline-block rounded-md px-3 py-2 font-display text-xs uppercase tracking-[0.16em] no-underline transition-colors',
                  active ? 'text-[var(--color-accent-bright)]' : 'text-[var(--color-fg-muted)] hover:text-white',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <details class="md:hidden">
      <summary class="list-none cursor-pointer p-2 -m-2 text-white" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </summary>
      <div class="absolute left-0 right-0 top-full border-b border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3">
        <ul class="flex flex-col gap-1">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-md px-3 py-3 font-display text-sm uppercase tracking-[0.16em] text-[var(--color-fg-muted)] no-underline hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>
  </div>
</header>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
