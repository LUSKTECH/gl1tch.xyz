---
import Base from '../../layouts/Base.astro';
import TwitchPlayer from '../../components/TwitchPlayer.astro';
import LiveStatus from '../../components/LiveStatus.astro';
import { channels, iframeParents, type Channel } from '../../data/channels';

type Props = { active: Channel };
const { active } = Astro.props;
---

<Base title={`Watch · ${active.label}`} description="Live and recent streams from the Toronto gl1tch crew.">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-display text-xs uppercase tracking-[0.3em] text-[var(--color-accent-bright)]">// Watch</p>
        <h1 class="mt-2 font-display text-3xl font-black uppercase tracking-widest text-white sm:text-4xl">
          {active.label}
        </h1>
      </div>
      <LiveStatus channel={active.twitchChannel} />
    </header>

    <nav aria-label="Channels" class="mb-6 flex flex-wrap gap-2">
      {channels.map((c) => {
        const isActive = c.slug === active.slug;
        return (
          <a
            href={`/stream/${c.slug}`}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'inline-flex items-center rounded-md border px-3 py-2 font-display text-xs uppercase tracking-[0.18em] no-underline transition-colors',
              isActive
                ? 'border-[var(--color-accent)] bg-[var(--color-accent)]/15 text-white'
                : 'border-[var(--color-border-strong)] text-[var(--color-fg-muted)] hover:text-white',
            ]}
          >
            {c.label}
          </a>
        );
      })}
    </nav>

    <TwitchPlayer channel={active.twitchChannel} parents={iframeParents} />

    <p class="mt-6 text-sm text-[var(--color-fg-muted)]">
      Prefer to watch on Twitch directly?{' '}
      <a href={active.twitchUrl} target="_blank" rel="noopener noreferrer">
        Follow on TWITCH.TV →
      </a>
    </p>
  </section>
</Base>
