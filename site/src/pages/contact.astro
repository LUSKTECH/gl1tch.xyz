---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Get in touch with Toronto gl1tch.">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="font-display text-xs uppercase tracking-[0.3em] text-[var(--color-accent-bright)]">// Contact</p>
    <h1 class="mt-2 font-display text-4xl font-black uppercase tracking-widest text-white sm:text-5xl">Get in touch</h1>

    <div class="prose-invert mt-8 space-y-4 text-[var(--color-fg-muted)]">
      <p>
        Fastest way to reach us is on
        <a href="https://discord.gg/UJQKFDk" target="_blank" rel="noopener noreferrer">Discord</a>
        or by replying on
        <a href="https://twitter.com/TorontoGl1tch" target="_blank" rel="noopener noreferrer">Twitter / X</a>.
      </p>
      <p>
        Want to roll with us? Skip the small talk and
        <a href="/join">apply to join</a>
        directly.
      </p>
    </div>
  </section>
</Base>
