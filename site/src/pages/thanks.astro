---
import Base from '../layouts/Base.astro';
---

<Base title="Transmission received" description="Your application to Toronto gl1tch was received.">
  <section class="mx-auto max-w-2xl px-4 py-24 sm:px-6">
    <div class="card border-[var(--color-accent)]" role="status" aria-live="polite">
      <p class="font-display text-xs uppercase tracking-[0.3em] text-[var(--color-accent-bright)]">// 200 OK</p>
      <h1 class="mt-2 font-display text-3xl font-black uppercase tracking-widest text-white sm:text-4xl">
        Transmission received.
      </h1>
      <p class="mt-4 text-[var(--color-fg-muted)]">
        Thanks for your interest in joining Toronto gl1tch. We've got your application and will be in touch.
      </p>
      <p class="mt-1 text-sm text-[var(--color-fg-muted)]">— I Strain I (Cody)</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-ghost">Back to home</a>
        <a href="/stream" class="btn btn-primary">Watch the stream</a>
      </div>
    </div>
  </section>
</Base>
