---
import Base from '../layouts/Base.astro';
---

<Base title="Blog" description="Posts from the Toronto gl1tch crew.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="font-display text-xs uppercase tracking-[0.3em] text-[var(--color-accent-bright)]">// Stand by</p>
    <h1 class="mt-3 font-display text-4xl font-black uppercase tracking-widest text-white sm:text-5xl">
      <span class="glitch" data-text="No signal">No signal</span>
    </h1>
    <p class="mt-6 text-[var(--color-fg-muted)]">
      The blog hasn't booted up yet. Until then, you can find us on
      <a href="/stream">Twitch</a> or in the
      <a href="https://discord.gg/UJQKFDk" target="_blank" rel="noopener noreferrer">Discord</a>.
    </p>
  </section>
</Base>
